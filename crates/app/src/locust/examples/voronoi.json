      "type": "Script",
      "nickname": "Wavy curves",
      "values": {
        "_inputs": [
          "A"
        ],
        "_outputs": [
          "curves"
        ],
        "code": "// three wavy curves to loft into a surface\ncurves = [];\nfor k in 0..3 {\n    let y = 40.0 * k;\n    let pts = [];\n    for i in 0..=12 {\n        let x = 10.0 * i;\n        pts.push(point(x, y + 100.0, A * sin(x / 15.0 + k)));\n    }\n    curves.push(interpolate(pts));\n}"
      }
    },
