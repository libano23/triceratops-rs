    {
      "type": "Script",
      "nickname": "Torus knot",
      "values": {
        "_inputs": [
          "p",
          "q",
          "R",
          "a",
          "tube"
        ],
        "_outputs": [
          "knot_tube"
        ],
        "R": 12,
        "a": 4,
        "tube": 1,
        "code": "// a (p, q) torus knot, swept with a circle into a tube\nlet pts = [];\nlet n = 160;\nfor i in 0..n {\n    let t = 2.0 * PI * i / n;\n    let r = R + a * cos(q * t);\n    pts.push(point(r * cos(p * t), r * sin(p * t), a * sin(q * t) + 3.0));\n}\nlet rail = interpolate(pts, true);\nlet start = curve_point(rail, 0.0);\nlet ahead = curve_point(rail, 0.001);\nlet profile = circle(start, tube, ahead - start);\nknot_tube = sweep1(rail, profile);"
      }
    },
